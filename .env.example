# Point this at the SAME database the TruckVal web app uses, so scraped rows
# land in the same truck_listings table. On Railway, reference the Postgres
# plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/database

# Optional tuning (defaults shown):
# TRUCK1_PAGES=20
# TRUCK1_CONCURRENCY=3
# TRUCK1_START=https://www.truck1.eu/trucks/all

# Apify API token — required only by apify-auctions-scraper.js, which reaches the
# auction sites that answer plain HTTP with 403 (rbauction and friends) by running
# a ready-made Apify actor. Get one at https://console.apify.com/account/integrations
# NOTE: Apify Proxy is NOT usable directly on the free plan (proxy.apify.com returns
# 403 for every group) — running actors is the only route that works.
APIFY_TOKEN=apify_api_your_token_here
