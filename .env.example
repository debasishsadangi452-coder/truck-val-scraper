# Point this at the SAME database the TruckVal web app uses, so scraped rows
# land in the same truck_listings table. On Railway, reference the Postgres
# plugin: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/database

# Optional tuning (defaults shown):
# TRUCK1_PAGES=20
# TRUCK1_CONCURRENCY=3
# TRUCK1_START=https://www.truck1.eu/trucks/all
